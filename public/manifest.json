{
  "name": "Arex Plus Chrome Extension",
  "version": "0.0.1",
  "manifest_version": 3,
  "description": "Provides more capabilities for Arex Plus",
  "homepage_url": "https://github.com/arex-plus",
  "icons": {
    "128": "logo-128.png"
  },
  "permissions": [
    "cookies",
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["interceptor.js"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_title": "Arex",
    "default_icon": "logo-128.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content-scripts.js"
      ],
      "run_at": "document_start"
    }
  ]
}
